# Copy this file to spark/.env before starting Docker Compose.
# Never commit the real API password.
SPARK_API_PASSWORD=replace_with_your_api_password
SPARK_BASE_URL=https://spark-api-open.xf-yun.com/agent/v1
SPARK_MODEL=spark-x
SPARK_MODEL_CANDIDATES=spark-x
SPARK_USER=learnloop
SPARK_ENABLE_THINKING=false
